---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found — Vivek Dogra" description="That page is not on this portfolio." robots="noindex, follow">
  <main class="shell flex min-h-[100svh] flex-col justify-center py-24">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-5xl font-semibold tracking-tight sm:text-7xl">This page is not here.</h1>
    <a class="btn-solid mt-10 w-fit" href={import.meta.env.BASE_URL}>Back to the portfolio</a>
  </main>
</Base>
