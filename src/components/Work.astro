---
import Frame from './Frame.astro'
import { roles } from '../data/site'
---

<section id="work" class="section-space scroll-mt-24">
  <div class="shell">
    <div class="reveal">
      <p class="eyebrow">02 / Selected work</p>
      <h2 class="mt-4 max-w-[12ch] text-4xl font-semibold tracking-tight sm:text-6xl md:text-7xl">Systems that shipped.</h2>
    </div>
    <div class="mt-16 md:mt-24">
      {
        roles.map((role, index) => {
          const flipped = index === 1
          const wide = index === 2
          const copy = (
            <div class={wide ? 'md:col-span-5' : 'mt-6 md:col-span-5'}>
              <p class="text-lg text-[var(--color-text)]">{role.headline}</p>
              <p class="mt-3 text-[var(--color-muted)]">{role.description}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {role.stack.map((item) => (
                  <li class="border border-[var(--color-line)] px-2.5 py-1 font-mono text-[0.68rem] tracking-wide text-[var(--color-muted)]">
                    {item}
                  </li>
                ))}
              </ul>
              <details class="mt-6">
                <summary class="btn-quiet">
                  <span class="when-closed">Read the work</span>
                  <span class="when-open">Hide details</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </summary>
                <ul class="space-y-3 pt-5">
                  {role.highlights.map((item) => (
                    <li class="flex gap-3 text-sm text-[var(--color-muted)]">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                      {item}
                    </li>
                  ))}
                </ul>
              </details>
            </div>
          )
          return (
            <article class="reveal border-t border-[var(--color-line)] py-12 md:py-20" data-cursor="view">
              {wide ? (
                <div>
                  <Frame kind={index} class="aspect-[16/8] md:aspect-[16/7]" />
                  <div class="mt-8 grid gap-8 md:grid-cols-12 md:items-end">
                    <div class="md:col-span-7">
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[0.68rem] tracking-[0.16em] text-[var(--color-faint)] uppercase">
                        <span class="text-[var(--color-accent)]">0{index + 1}</span>
                        <span>{role.role}</span>
                        <span>{role.period}</span>
                      </div>
                      <h3 class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl">{role.company}</h3>
                    </div>
                    {copy}
                  </div>
                </div>
              ) : (
                <div class="grid items-center gap-8 md:grid-cols-12 md:gap-12">
                  <Frame kind={index} class={`aspect-[4/3] md:col-span-7 ${flipped ? 'md:order-2' : ''}`} />
                  <div class="md:col-span-5">
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[0.68rem] tracking-[0.16em] text-[var(--color-faint)] uppercase">
                      <span class="text-[var(--color-accent)]">0{index + 1}</span>
                      <span>{role.role}</span>
                      <span>{role.period}</span>
                    </div>
                    <h3 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{role.company}</h3>
                    {copy}
                  </div>
                </div>
              )}
            </article>
          )
        })
      }
    </div>
  </div>
</section>
