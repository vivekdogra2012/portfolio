---
import { profile } from '../data/site'
const year = new Date().getFullYear()
---

<footer class="border-t border-[var(--color-line)]">
  <div class="shell flex flex-col gap-8 py-10 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold tracking-[0.16em]">VIVEK DOGRA</p>
      <p class="mt-1 text-sm text-[var(--color-muted)]">{profile.title}</p>
    </div>
    <div class="flex flex-wrap gap-5 text-sm text-[var(--color-muted)]">
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text)]">GitHub</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text)]">LinkedIn</a>
      <a href={`mailto:${profile.email}`} class="hover:text-[var(--color-text)]">Email</a>
    </div>
    <div class="text-sm text-[var(--color-faint)]">
      <p>© {year} Vivek Dogra</p>
      <p class="mt-1">Designed & engineered with curiosity.</p>
    </div>
  </div>
</footer>
