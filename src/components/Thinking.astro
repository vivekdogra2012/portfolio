---
import { beliefs, thinking } from '../data/site'
---

<section id="thinking" class="section-space scroll-mt-24">
  <div class="shell">
    <div class="reveal">
      <p class="eyebrow">06 / How I think</p>
      <h2 class="mt-4 max-w-[14ch] text-4xl font-semibold tracking-tight sm:text-6xl">Past the component.</h2>
      <p class="mt-6 max-w-xl text-[var(--color-muted)]">
        I trace a feature from the product decision through the interface, the client API, and the platform underneath — so the UI can move without a rewrite.
      </p>
    </div>
    <div class="relative mt-14">
      <div class="mb-4 hidden overflow-hidden lg:block" aria-hidden="true">
        <div class="h-px bg-white/10"></div>
        <div class="signal relative -mt-px h-px w-1/6 bg-[var(--color-accent)]"></div>
      </div>
      <ol class="grid gap-px bg-[var(--color-line)] sm:grid-cols-2 lg:grid-cols-6">
        {
          thinking.map((step, index) => (
            <li class="reveal relative bg-[var(--color-bg)] px-4 py-6">
              <span class="absolute top-0 left-0 h-px w-full origin-left bg-[var(--color-accent)]"></span>
              <span class="font-mono text-[0.65rem] tracking-[0.18em] text-[var(--color-accent)]">0{index + 1}</span>
              <p class="mt-3 text-lg font-medium tracking-tight">{step}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="mt-16 grid gap-10 md:grid-cols-3">
      {
        beliefs.map((belief) => (
          <div class="reveal">
            <h3 class="text-xl font-semibold tracking-tight">{belief.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">{belief.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
